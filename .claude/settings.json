{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "customInstructions": "CRITICAL: Safe Testing Policy - ALWAYS use /quick-validate instead of /build. NEVER use /sim (use /sim-safe or /device-deploy). Memory rules auto-load context based on keywords. Use shared knowledge base (~/.claude/knowledge-base/) for cross-repo patterns.",
  "attribution": {
    "commit": "🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "🤖 Generated with [Claude Code](https://claude.com/claude-code)"
  },
  "memoryRules": {
    "enabled": true,
    "autoLoad": true,
    "triggerKeywords": {
      "safe-testing.md": ["test", "build", "run", "validate", "simulator"],
      "swift-concurrency.md": ["@Observable", "@MainActor", "actors", "SwiftData"],
      "multi-agent-workflows.md": ["workflow", "multi-agent", "delegation", "parallel", "background"],
      "git-workflows.md": ["commit", "git", "pull request", "pr", "attribution"],
      "claude-code-patterns.md": ["claude code", "settings", "hooks", "sessions"],
      "swiftlint-integration.md": ["swiftlint", "linting", "code quality", "architecture rules"]
    }
  },
  "fileSuggestion": {
    "type": "command",
    "command": "git ls-files --cached --others --exclude-standard",
    "maxResults": 50
  },
  "subagentModels": {
    "cloudflare-specialist": "sonnet",
    "code-review-grok": "grok-code-fast-1",
    "code-architecture-reviewer": "grok-code-fast-1",
    "security-auditor": "grok-code-fast-1",
    "performance-analyzer": "gemini-2.5-pro",
    "refactor-planner": "opus",
    "Plan": "opus",
    "Explore": "haiku"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "command": ".claude/hooks/session-start.sh"}]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "command": ".claude/hooks/session-end.sh"}]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "command": ".claude/hooks/permission-request.sh"}]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": ".claude/hooks/pre-commit.sh"}]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "command": ".claude/hooks/subagent-start.sh"}]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "command": ".claude/hooks/subagent-stop.sh"}]
      }
    ]
  },
  "respectGitIgnore": true,
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "25000",
    "CLAUDE_CODE_SUBAGENT_PARALLEL": "true",
    "MCP_CONTEXT_OPTIMIZATION": "true"
  },
  "permissions": {
    "rules": [
      {
        "type": "allow",
        "tools": ["SlashCommand"],
        "comment": "Allow slash commands (/build, /test, /sim, /device-deploy)"
      },
      {
        "type": "allow",
        "tools": ["Bash"],
        "patterns": ["git status", "git diff", "git log"],
        "comment": "Allow safe git read operations"
      },
      {
        "type": "allow",
        "tools": ["Read", "Glob", "Grep", "Edit", "Write"],
        "comment": "Allow file reading, searching, and editing"
      },
      {
        "type": "allow",
        "tools": [
          "mcp__pal__chat",
          "mcp__pal__thinkdeep",
          "mcp__pal__planner",
          "mcp__pal__consensus",
          "mcp__pal__codereview",
          "mcp__pal__debug",
          "mcp__pal__secaudit",
          "mcp__pal__challenge",
          "mcp__pal__apilookup",
          "mcp__pal__listmodels",
          "mcp__pal__version",
          "mcp__pal__clink",
          "mcp__pal__precommit",
          "mcp__pal__docgen",
          "mcp__pal__analyze",
          "mcp__pal__refactor",
          "mcp__pal__tracer",
          "mcp__pal__testgen"
        ],
        "comment": "Allow all PAL MCP tools"
      },
      {
        "type": "ask",
        "tools": ["Bash"],
        "patterns": ["git add", "git commit", "git push"],
        "comment": "Require approval for git write operations"
      },
      {
        "type": "ask",
        "tools": ["Bash"],
        "patterns": ["rm ", "mv ", "cp "],
        "comment": "Require approval for destructive file operations"
      },
      {
        "type": "deny",
        "tools": ["Bash"],
        "patterns": ["rm -rf /", "sudo rm", "git push --force"],
        "comment": "Block dangerous operations"
      }
    ]
  },
  "ignorePatterns": [
    "**/.git/**",
    "**/node_modules/**",
    "**/DerivedData/**",
    "**/.build/**",
    "**/*.xcworkspace/xcuserdata/**",
    "**/*.xcodeproj/xcuserdata/**",
    "**/*.xcodeproj/project.xcworkspace/xcuserdata/**"
  ],
  "compactMode": {
    "enabled": true,
    "threshold": 0.8
  },
  "asyncAgents": {
    "enabled": true,
    "maxConcurrent": 3,
    "wakeOnMessage": true
  },
  "spinnerTipsEnabled": true,
  "verbose": false,
  "sharedKnowledgeBase": {
    "enabled": true,
    "location": "~/.claude/knowledge-base",
    "autoSync": true,
    "patterns": ["patterns", "architectures", "debugging", "decisions"]
  },
  "modernFeatures": {
    "modelSwitching": {
      "enabled": true,
      "shortcut": "option+p"
    },
    "namedSessions": {
      "enabled": true,
      "autoName": false
    },
    "usageStats": {
      "enabled": true,
      "trackStreaks": true
    }
  },
  "mcpOptimization": {
    "enabled": true,
    "compactDescriptions": true,
    "hideUnusedTools": true,
    "contextTokenLimit": 25000
  }
}