#!/bin/bash
# Pre-commit hook for BooksTracker
# Auto-updates build numbers on commits

# Disable exit on error to prevent blocking commits in CI/limited environments
set +e

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BLUE}🔄${NC} Pre-commit: Updating build number..."

# Get project root (from .git/hooks to project root)
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# If running from .githooks (not .git/hooks), adjust root calculation
if [[ "$HOOK_DIR" == *".githooks" ]]; then
    PROJECT_ROOT="$(dirname "$HOOK_DIR")"
else
    PROJECT_ROOT="$(dirname "$(dirname "$HOOK_DIR")")"
fi

SCRIPT_PATH="$PROJECT_ROOT/Scripts/update_version.sh"

if [ -f "$SCRIPT_PATH" ]; then
    # Try to run the script
    if "$SCRIPT_PATH" build; then
        # Stage the updated config file
        if git add "$PROJECT_ROOT/Config/Shared.xcconfig"; then
            echo -e "${GREEN}✅${NC} Build number updated and staged"
        else
            echo -e "${RED}⚠️ Failed to stage build number update${NC}"
        fi
    else
        echo -e "${YELLOW}⚠️ Update version script failed to run (skipping)${NC}"
    fi
else
    echo -e "${YELLOW}⚠️ Scripts/update_version.sh not found at $SCRIPT_PATH${NC}"
    echo -e "${YELLOW}⚠️ Skipping build number update (Scripts directory missing?)${NC}"
fi

# Always exit successfully
exit 0
